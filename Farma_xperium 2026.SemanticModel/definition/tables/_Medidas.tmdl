	measure 'Receita liquida Formatado' =
			
			VAR vValor = [Receita liquida]
			RETURN
			SWITCH(
			    true(),
			    vValor >= 1000000000, FORMAT(vValor,"0,0,,,.0 B"),
			    vValor >= 1000000., FORMAT(vValor, "0,0,,.0 M"),
			    vValor >= 1000., FORMAT(vValor, "0,0,.0 k"),
