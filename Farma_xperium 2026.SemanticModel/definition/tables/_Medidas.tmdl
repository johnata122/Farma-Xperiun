		lineageTag: 0b5203de-254a-4730-951c-0f410b7b377b

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Atingimento % Meta Rec.' = DIVIDE([Receita liquida],[Meta da Receita - Fix],0)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: 1. Principais
		lineageTag: 30bb39be-bb1b-45eb-b59b-c92b9fcecda1

	measure 'Faturamento Bruto Formatado' =
			
			VAR vValor = [Receita Bruta]
			RETURN
			SWITCH(
			    true(),
			    vValor >= 1000000000, FORMAT(vValor,"0,0,,,.0 B"),
			    vValor >= 1000000., FORMAT(vValor, "0,0,,.0 M"),
			    vValor >= 1000., FORMAT(vValor, "0,0,.0 k"),
			    FORMAT(vValor, "0")
			)
		displayFolder: 1. Principais
		lineageTag: 286184b8-b643-4019-9d22-0af6bc796e8e

	measure 'YOY Receita bruta %' = ```
			
			VAR Valor_last_year = [Receita Bruta LY]
			
			RETURN 
			    DIVIDE(
			        [Receita Bruta] - Valor_last_year,
			        Valor_last_year
			    )
			```
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: 3. Temporais
		lineageTag: 3e50e6a3-9e62-400b-8a05-d7706199b424

	measure 'imagem Var Receita Bruta' = ```
			
			
			Var vValor = [YOY Receita bruta %]
			Var vValor_Formatado = FORMAT(vValor + 0,"+0.0%;-0.0%;-")
			
			Var vSeta = SWITCH(
			    TRUE(),
			    vValor > 0, "▲",
			    vValor < 0, "▼")
			
			Var vCor = SWITCH(
			    TRUE(),
			    vValor> 0, "#55af3b",
			    vValor < 0,"#D16961",
			    "#fff")
			
			
			RETURN
			
			
			 "data:image/svg+xml,
			
			 <svg width='180' height='50' viewBox='0 0 180 50' fill='none' xmlns='http://www.w3.org/2000/svg'>
			   <g id='Cart&#195;&#163;o Var'>
			      <g clip-path='url(#clip0_29108_274)'>
			         <rect width='180' height='50' rx='5' fill='#EEF0F1'/>
			
			         <text id='rot_cat' fill='#263238'
			
			          xml:space='preserve' style='white-space: pre' font-family='Scheherazade' font-size='14' letter-spacing='0em'>
			
			            <tspan x='81' y='44.3413'>Vs Ano Anterior</tspan>
			         </text>
			
			         <text id='rot_dados'
			          opacity='0.5' fill='"&vCor&"' fill-opacity='0.89' xml:space='preserve' style='white-space: pre' font-family='Scheherazade' font-size='17' font-weight='bold' letter-spacing='0em'>
			            <tspan x='82' y='27.3447'>    "&vValor_Formatado&"    </tspan>
			         </text>
			
			         <text id='seta' 
			         
			         opacity='0.5' fill='"&vCor&"' xml:space='preserve' style='white-space: pre' font-family='Scheherazade' font-size='20' font-weight='bold' letter-spacing='0em'>
			            <tspan x='42' y='37.1770'>   "&vSeta&"    </tspan>
			         </text>
			      </g>
			   </g>
			   <defs>
			      <clipPath id='clip0_29108_274'>
			         <rect width='180' height='50' rx='5' fill='white'/>
			      </clipPath>
			   </defs>
			</svg>"
			```
		displayFolder: 4. Auxiliares
		lineageTag: 40550cf2-6c8e-4a55-8c94-3039d8b5b514

