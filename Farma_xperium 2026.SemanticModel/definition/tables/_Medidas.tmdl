	measure '% Receita Fornecedor' =
			
			DIVIDE(
			    [Receita Bruta],
			    CALCULATE(
			        [Receita Bruta],
			        ALL(dfornecedor)
			    )
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: 1. Principais
		lineageTag: 4429321a-89cb-4012-bf55-654f78899109

	measure 'Classificação Fornecedor' =
			
			SWITCH(
			    TRUE(),
			    [% Receita Fornecedor] >= 0.20 && [Margem %] >= 0.25, "Estratégico",
			    [% Receita Fornecedor] >= 0.20 && [Margem %] < 0.25, "Negociação",
			    [% Receita Fornecedor] < 0.20 && [Margem %] >= 0.25, "Oportunidade",
			    "Baixa Prioridade"
			)
		displayFolder: 1. Principais
		lineageTag: c39df532-a34c-4e7d-baa0-a5dc40340d51

	partition _Medidas = m
		mode: import
		source =
				let
				    Fonte = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i44FAA==", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [#"Coluna 1" = _t]),
				    #"Tipo Alterado" = Table.TransformColumnTypes(Fonte,{{"Coluna 1", type text}}),
				    #"Colunas Removidas" = Table.RemoveColumns(#"Tipo Alterado",{"Coluna 1"})
				in
				    #"Colunas Removidas"

	annotation PBI_ResultType = Table

