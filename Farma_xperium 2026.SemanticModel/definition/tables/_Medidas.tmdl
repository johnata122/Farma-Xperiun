table _Medidas
	lineageTag: 99bf2a32-4bef-42a3-8b0c-3cffffc4f212

	measure 'Custo Total' = SUM(fvendas[custo_total])
		displayFolder: 1. Principais
		lineageTag: 9a5b3095-d98e-4aa2-98f5-5880e434a6d3

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Lucro T.' = [Receita liquida]-[Custo Total]
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: 1. Principais
		lineageTag: d8117a71-9875-4bb1-b989-1800d3a17b6c

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure 'Qtde Vendas' = DISTINCTCOUNT(fvendas[venda_id])
		formatString: #,0.000
		displayFolder: 1. Principais
		lineageTag: 1f264c56-e794-46fd-8056-223a5c7eb819

	measure 'Receita Bruta' = sumx(fvendas,fvendas[quantidade]*fvendas[preco_unitario])
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: 1. Principais
		lineageTag: 8294750f-24bc-4781-add5-a6a9e8cc1c65

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure 'Receita liquida' = [Receita Bruta]-sumx(fvendas,fvendas[desconto])
		displayFolder: 1. Principais
		lineageTag: 3d09827e-b0dc-422f-b870-d0bd1abcbf78

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Ticket Médio' = DIVIDE([Receita Bruta],DISTINCTCOUNT(fvendas[venda_id]),0)
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: 1. Principais
		lineageTag: 6824bc8b-8c4d-46ef-be71-50380b5ccaf3

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure 'Margem %' = DIVIDE([Lucro T.], [Receita liquida],0)
